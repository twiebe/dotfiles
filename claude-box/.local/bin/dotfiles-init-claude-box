#!/usr/bin/env zsh

set -e

REPO_URL="https://github.com/twiebe/claude-box.git"
TARGET_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/claude-box"

if [[ -d "${TARGET_DIR}/.git" ]]; then
  echo "updating ${TARGET_DIR}"
  git -C "${TARGET_DIR}" pull --ff-only
else
  git clone "${REPO_URL}" "${TARGET_DIR}"
fi

# claude-box used to be stowed from here. Its old ~/.config/claude-box link now
# points at nothing; install.sh replaces the ~/.local/bin/cb one on its own.
if [[ -L "${HOME}/.config/claude-box" && ! -e "${HOME}/.config/claude-box" ]]; then
  rm "${HOME}/.config/claude-box"
fi

"${TARGET_DIR}/install.sh"

# Thorsten's voice for `cb --speak` (see .zshrc.d/90-claude-box.zsh): piper as a
# uv tool, and the voice next to where the speech command looks for it. Python
# 3.14, since piper-tts does not install on 3.15 (yet).
PIPER_VOICES="${HOME}/.local/share/piper"
PIPER_VOICE="de_DE-thorsten-high"

if (( $+commands[uv] )); then
  if [[ ! -d "$(uv tool dir)/piper-tts" ]]; then
    uv tool install --python 3.14 piper-tts
  fi
  if [[ ! -r "${PIPER_VOICES}/${PIPER_VOICE}.onnx" || ! -r "${PIPER_VOICES}/${PIPER_VOICE}.onnx.json" ]]; then
    mkdir -p "${PIPER_VOICES}"
    "$(uv tool dir)/piper-tts/bin/python3" -m piper.download_voices \
      --data-dir "${PIPER_VOICES}" "${PIPER_VOICE}"
  fi
else
  echo "uv not found, skipping piper and Thorsten's voice"
fi
