#!/usr/bin/env python3
"""claude-box: a fresh container per run, with Claude Code in it."""

import hashlib
import json
import os
import re
import secrets
import shlex
import subprocess
import sys
import urllib.request

CB_DIR = os.path.expanduser("~/.config/claude-box")

# One tag for every box. The Dockerfile in CB_DIR produces it.
CB_IMAGE = "claude-box:latest"

CLAUDE_PACKAGE = "@anthropic-ai/claude-code"

# Set by --dry-run. Every command that would change something goes through
# run(), so one flag covers all of them.
DRY_RUN = False


class CbError(Exception):
    """Anything cb reports as one line rather than as a traceback."""

    code = 1


class UsageError(CbError):
    """A mistake on the command line."""

    code = 2


class MissingBinary(CbError):
    """docker is not on PATH."""

    code = 127

    def __init__(self, name):
        super().__init__("{} not found on PATH".format(name))


# ---------------------------------------------------------------------------
# Identity
#
# A box belongs to the directory it was launched from. Two names are derived
# from that path: a slug, which is readable and appears in the workspace path
# inside the box, and a hash, which makes the pair unique. Each run adds a
# random suffix of its own to the container name (see run_argv).
# ---------------------------------------------------------------------------

NAME_PREFIX = "cb"


def slug(basename):
    """Readable half of a box's identity, derived from a directory name.

    Used for both the container name and the workspace path inside the box, so
    only [a-z0-9-] survives: underscores and dots are fine for a container name
    but not for a hostname, and --hostname gets the same value.

    Runs of dashes collapse and the edges are trimmed, otherwise a dotted
    directory name reads badly — ~/.dotfiles would become cb--dotfiles and
    /workspaces/-dotfiles. A name made up entirely of discarded characters
    falls back to "box".
    """
    cleaned = re.sub(r"[^a-zA-Z0-9-]", "-", basename)
    cleaned = re.sub(r"-+", "-", cleaned).strip("-")
    return (cleaned or "box").lower()


def path_hash(path):
    """Unique half of a box's identity: a short digest of the absolute path.

    Tells two checkouts with the same directory name apart. The zsh version
    took the first 8 characters of sha256 over $PWD; keeping that exact
    definition means cb finds the containers it created.
    """
    return hashlib.sha256(path.encode()).hexdigest()[:8]


def current_workspace():
    """The directory this box belongs to, spelled the way the shell spells it.

    os.getcwd() resolves symlinks; the shell's $PWD does not. The path is what
    the container name and the settings file are hashed from and what cb stamps
    on the container as its folder label, so the two spellings would be two
    identities for one checkout. Preferring $PWD keeps a checkout reached
    through a symlink at one identity.

    $PWD is only believed when it still names this directory: a subshell that
    chdir'd without updating it, or an exported value from somewhere else, would
    otherwise rename the box.
    """
    logical = os.environ.get("PWD")
    if logical and os.path.isabs(logical):
        try:
            if os.path.samefile(logical, os.getcwd()):
                return logical
        except OSError:
            pass
    return os.getcwd()


def container_name(path):
    return "{}-{}-{}".format(NAME_PREFIX, slug(os.path.basename(path)), path_hash(path))


# ---------------------------------------------------------------------------
# Settings
#
# One file per box, remembering the answers that would otherwise have to be
# repeated on every invocation. Flag beats file beats default, and the flag
# that wins is also written back, so `cb --docker` once is permanent.
#
# The store lives under XDG_STATE_HOME and not next to the Dockerfile, because
# that directory is stowed: stow folds a directory it alone owns into a single
# symlink, so writing there would write into the dotfiles checkout.
# ---------------------------------------------------------------------------

SETTINGS_VERSION = 1

# Key to default. Also the whitelist: anything else in the file is ignored, so
# a leftover from an older version cannot change how a box starts.
SETTINGS_DEFAULTS = {
    "docker": False,
    "force": False,
}


def read_json(path):
    """Parsed contents of `path`, or {} if there are none to be had.

    A missing file is the normal case for something never configured.
    Unparseable JSON is treated the same way rather than as an error: the
    defaults are the safe ones, and a stray comma in a hand-edited file must not
    stop a box from starting.
    """
    try:
        with open(path) as handle:
            parsed = json.load(handle)
    except (OSError, ValueError):
        return {}
    return parsed if isinstance(parsed, dict) else {}


def write_json(path, data):
    """Write `data` to `path`, unless this is a dry run.

    The check belongs here rather than at each call site: --dry-run promises to
    change nothing, and remembering --docker while printing the command it did
    not run would break that quietly.
    """
    if DRY_RUN:
        print("+ write " + str(path))
        return
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as handle:
        json.dump(data, handle, indent=2, sort_keys=True)
        handle.write("\n")


def state_dir():
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "claude-box")


def settings_path(path):
    """Where the settings for the box in `path` live.

    Named after the box without its per-run suffix, so `ls` on the store and
    `docker ps` line up.
    """
    return os.path.join(state_dir(), "projects", container_name(path) + ".json")


def load_settings(path):
    """Stored settings, or {} if there are none to be had.

    A missing file is the normal case for a box that has never been configured.
    Unparseable JSON is treated the same way rather than as an error: the
    defaults are the safe ones, and a stray comma in a hand-edited file must not
    stop a box from starting.
    """
    return read_json(path)


def save_settings(path, overrides, workspace):
    """Merge `overrides` into the stored settings and write them back.

    A None override means the flag was not given and leaves the stored value
    alone — --docker and --no-docker share one destination, so absent has to be
    distinguishable from False.

    `workspace` is recorded so `cb config --prune` can tell which entries belong
    to directories that no longer exist.
    """
    stored = load_settings(path)
    stored["version"] = SETTINGS_VERSION
    stored["path"] = workspace
    for key, value in overrides.items():
        if value is not None:
            stored[key] = value

    write_json(path, stored)
    return stored


def resolve_settings(stored, overrides):
    """Effective settings as {key: (value, source)}.

    The source is what `cb config` prints, and the reason this returns pairs
    rather than plain values: "docker true" is not actionable, "docker true
    (flag)" tells you the file still says something else.
    """
    resolved = {}
    for key, default in SETTINGS_DEFAULTS.items():
        if overrides.get(key) is not None:
            resolved[key] = (overrides[key], "flag")
        elif key in stored:
            resolved[key] = (stored[key], "file")
        else:
            resolved[key] = (default, "default")
    return resolved


# ---------------------------------------------------------------------------
# Command line
#
# `cb` is two CLIs sharing a name: its own subcommands, and a passthrough to
# claude for the common case. The split has to happen before argparse, because
# argparse would choke on claude's flags — and would be wrong to reject them.
# ---------------------------------------------------------------------------

SUBCOMMANDS = (
    "run",
    "ls",
    "exec",
    "shell",
    "mount",
    "rebuild-image",
    "update-claude",
    "config",
    "volume",
)

# Gone with the long-lived boxes. Without this they would reach claude as a
# prompt — `cb down` would start a box to ask about "down". `cb -- down` still
# does, for anyone who means it.
REMOVED_SUBCOMMANDS = {
    "up": "it is called `cb run` now",
    "recreate": "every run starts a fresh box",
    "down": "boxes are removed when they exit",
}

# Everything after these is a command line of its own and is left untouched:
# `cb exec docker ps --force` passes --force to docker, not to cb.
VERBATIM_SUBCOMMANDS = ("exec",)

# The flags cb keeps for itself. Deliberately short — every name here is one
# claude can never be given without `--`. Checked against claude's flags; there
# is no overlap today.
TOGGLE_FLAGS = {
    "--docker": ("docker", True),
    "--no-docker": ("docker", False),
    "--force": ("force", True),
}
SWITCH_FLAGS = {
    "-y": "yes",
    "--yes": "yes",
    "--dry-run": "dry_run",
    "-h": "help",
    "--help": "help",
}

# Flags that take the next argument as their value. -v is also claude's
# --version; `cb -- -v` reaches that one.
VALUE_FLAGS = {
    "-v": "volumes",
    "--volume": "volumes",
}


def leading_flags_end(argv):
    """Index of the first token that is not one of cb's own flags.

    cb's flags may come before the subcommand — `cb --docker shell` — so that is
    where the subcommand is looked for. A value flag takes its value along: in
    `cb -v ls` the ls is a directory.
    """
    index = 0
    while index < len(argv):
        if argv[index] in VALUE_FLAGS:
            index += 2
        elif argv[index] in TOGGLE_FLAGS or argv[index] in SWITCH_FLAGS:
            index += 1
        else:
            break
    return min(index, len(argv))


def pick_subcommand(argv):
    """Split argv into a subcommand and the arguments around it.

    The first token past cb's own leading flags is considered, and nothing
    later. Anything else is claude's line, where a word that happens to match a
    subcommand name is just a word: `cb -p down` asks claude about something
    called down.

    A word from REMOVED_SUBCOMMANDS in that position is refused rather than
    handed to claude as a prompt.
    """
    index = leading_flags_end(argv)
    word = argv[index] if index < len(argv) else None
    if word in REMOVED_SUBCOMMANDS:
        raise UsageError("cb {} is gone: {}".format(word, REMOVED_SUBCOMMANDS[word]))
    if word in SUBCOMMANDS:
        return word, list(argv[:index]) + list(argv[index + 1:])
    return "run", list(argv)


def extract_flags(args):
    """Pull cb's reserved flags out of a line that otherwise belongs to claude.

    Returns (flags, rest). Toggles are tri-state: None means the flag was not
    given and the stored setting stands, True and False are the two spellings of
    an explicit answer.

    Reserved flags are recognised wherever they appear, because the surrounding
    arguments belong to claude and cannot be reordered around a fixed position.
    `--` ends the search; what precedes it has already been taken.

    Value flags take the argument that follows them. A missing value is refused
    rather than swallowing claude's next word.
    """
    flags = {
        "docker": None,
        "force": None,
        "yes": False,
        "dry_run": False,
        "help": False,
        "volumes": [],
    }
    rest = []

    args = list(args)
    while args:
        arg = args.pop(0)
        if arg == "--":
            rest.extend(args)
            break
        if arg in TOGGLE_FLAGS:
            key, value = TOGGLE_FLAGS[arg]
            flags[key] = value
        elif arg in SWITCH_FLAGS:
            flags[SWITCH_FLAGS[arg]] = True
        elif arg in VALUE_FLAGS:
            if not args or args[0] == "--":
                raise UsageError("{} needs a value: SRC[:DST][:ro]".format(arg))
            flags[VALUE_FLAGS[arg]].append(args.pop(0))
        else:
            rest.append(arg)

    return flags, rest


# ---------------------------------------------------------------------------
# Image features
#
# The toolchains in the image are optional at build time. They are a property
# of the image and not of a box: one image, one tag, so a lean set costs
# nothing to resolve and cannot leave two boxes fighting over a tag.
#
# All default to on, which is what keeps a bare `docker build` in
# .config/claude-box producing the same image cb builds — the Dockerfile has to
# stand on its own, without cb's --build-arg list in front of it.
# ---------------------------------------------------------------------------

IMAGE_FEATURES = ("docker", "go", "kubernetes", "playwright", "rust", "sqlx", "tofu")

# The image carries its own answer as a label, so `docker inspect` stays
# authoritative even when the state file has been lost or hand-edited. The file
# only remembers what to build next time.
FEATURE_LABEL = "cb.features"


def extract_feature_flags(args):
    """Pull --with-X / --without-X out of `args`, leaving everything else."""
    overrides = {feature: None for feature in IMAGE_FEATURES}
    rest = []
    for arg in args:
        if arg.startswith("--with-") and arg[len("--with-"):] in overrides:
            overrides[arg[len("--with-"):]] = True
        elif arg.startswith("--without-") and arg[len("--without-"):] in overrides:
            overrides[arg[len("--without-"):]] = False
        else:
            rest.append(arg)
    return overrides, rest


def resolve_features(stored, overrides):
    """Effective feature set: flag beats file beats on.

    sqlx-cli is a cargo build, so it cannot outlive the toolchain: dropping rust
    drops it too. Asking for both at once is refused rather than resolved,
    because either answer contradicts one of the two flags.
    """
    if overrides.get("rust") is False and overrides.get("sqlx") is True:
        raise UsageError("--with-sqlx needs rust; drop --without-rust")

    features = {}
    for feature in IMAGE_FEATURES:
        if overrides.get(feature) is not None:
            features[feature] = overrides[feature]
        elif feature in stored:
            features[feature] = bool(stored[feature])
        else:
            features[feature] = True

    if not features["rust"]:
        features["sqlx"] = False
    return features


def feature_label(features):
    """The label value baked into the image."""
    return ",".join(
        "{}={}".format(name, int(value)) for name, value in sorted(features.items())
    )


def parse_feature_label(label):
    """Read back what feature_label wrote.

    Unknown and malformed entries are dropped rather than raising: the label is
    read from whatever image happens to be tagged claude-box:latest, which may
    predate the feature it is being asked about.
    """
    features = {}
    for entry in (label or "").split(","):
        name, _, value = entry.partition("=")
        if name in IMAGE_FEATURES and value in ("0", "1"):
            features[name] = value == "1"
    return features


def feature_build_args(features):
    """`WITH_X=…` assignments, one per feature, for `docker build --build-arg`."""
    return [
        "WITH_{}={}".format(name.upper(), int(value))
        for name, value in sorted(features.items())
    ]


# ---------------------------------------------------------------------------
# The directory gate
#
# A box bind-mounts the directory it is launched from and hands it to an agent
# with permissions loosened, so starting one in the wrong place — $HOME, /, a
# directory reached by a stray cd — is the expensive mistake. Checkouts live in
# ~/git and scratch work in ~/tmp; anything else is a typo until --force says
# otherwise, and --force is remembered per box.
# ---------------------------------------------------------------------------

DEFAULT_ROOTS = ("~/git", "~/tmp")


def roots():
    """Where boxes may be started. CB_ROOTS overrides, colon separated."""
    configured = os.environ.get("CB_ROOTS")
    entries = configured.split(":") if configured else DEFAULT_ROOTS
    return [os.path.expanduser(entry) for entry in entries if entry]


def in_roots(path, allowed):
    """Is `path` one of `allowed`, or below one?

    Compares resolved paths, so a symlinked ~/git — or a cd through one — still
    counts, and a root that does not exist simply never matches. The separator
    in the prefix test is what keeps ~/gitignored from passing as ~/git.
    """
    here = os.path.realpath(path)
    for root in allowed:
        if not os.path.isdir(root):
            continue
        resolved = os.path.realpath(root)
        if here == resolved or here.startswith(resolved.rstrip(os.sep) + os.sep):
            return True
    return False


# ---------------------------------------------------------------------------
# Running things
# ---------------------------------------------------------------------------


def run(argv, env=None, quiet=False, check=True):
    """Run `argv`, inheriting the terminal unless `quiet`.

    `env` replaces the whole environment, so a caller passing one starts from
    os.environ. What it adds is spelled out by --dry-run, which would otherwise
    print a command that behaves differently when pasted.
    """
    if DRY_RUN:
        added = "".join(
            "{}={} ".format(key, shlex.quote(value))
            for key, value in sorted((env or {}).items())
            if os.environ.get(key) != value
        )
        print("+ " + added + shlex.join(argv))
        return 0
    try:
        completed = subprocess.run(
            argv,
            env=env,
            stdout=subprocess.DEVNULL if quiet else None,
        )
    except FileNotFoundError:
        raise MissingBinary(argv[0])
    if check and completed.returncode:
        raise command_failed(argv[0], completed.returncode)
    return completed.returncode


def capture(argv):
    """Standard output of `argv`, or None if it failed.

    Failure is an answer here, not an error: "no such container" and "no such
    image" are both routine and both arrive this way.
    """
    try:
        completed = subprocess.run(
            argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
        )
    except FileNotFoundError:
        raise MissingBinary(argv[0])
    if completed.returncode:
        return None
    return completed.stdout.decode()


def command_failed(name, code):
    """A failed subprocess, reported with its own exit code rather than cb's."""
    error = CbError("{} exited {}".format(name, code))
    error.code = code
    return error


def confirm(question, assume_yes):
    """Ask, unless -y was given or there is nobody to ask."""
    if assume_yes:
        return True
    if not sys.stdin.isatty():
        return False
    try:
        answer = input(question + " [y/N] ")
    except EOFError:
        return False
    return answer.strip().lower() in ("y", "yes")


# ---------------------------------------------------------------------------
# Docker
#
# Boxes are found by the labels cb stamps on them — one saying this is a box at
# all, one naming the host folder it was launched from. Only running ones
# exist: every box is started with --rm.
# ---------------------------------------------------------------------------

BOX_LABEL = "cb.box"

# The value of BOX_LABEL. Boxes from the long-lived lifecycle carry 1 and idle
# until removed; asking for this value keeps them out of `cb ls` and away from
# `cb exec`.
BOX_GENERATION = "2"
FOLDER_LABEL = "cb.folder"

PS_FORMAT = '{{.Names}}\t{{.RunningFor}}\t{{.Label "%s"}}' % FOLDER_LABEL

TABLE_HEADER = ("NAME", "STARTED", "FOLDER")


def parse_ps_rows(out):
    """(name, started, folder) per line of PS_FORMAT output."""
    rows = []
    for line in out.splitlines():
        if not line.strip():
            continue
        name, started, folder = (line.split("\t") + ["", ""])[:3]
        rows.append((name, started, folder or "-"))
    return rows


def format_table(rows):
    """Render `rows` under TABLE_HEADER, columns padded to the widest cell.

    Built here rather than by `docker ps --format table …` so the header and the
    padding stay the same whether there are rows or not.
    """
    cells = [TABLE_HEADER] + [tuple(row) for row in rows]
    widths = [max(len(row[i]) for row in cells) for i in range(len(TABLE_HEADER))]
    lines = [
        "  ".join(value.ljust(width) for value, width in zip(row, widths)).rstrip()
        for row in cells
    ]
    return "\n".join(lines)


def running_boxes():
    out = capture(
        [
            "docker", "ps", "--format", PS_FORMAT,
            "--filter", "label={}={}".format(BOX_LABEL, BOX_GENERATION),
        ]
    )
    if out is None:
        raise CbError("docker is not answering — is the daemon running?")
    return parse_ps_rows(out)


def pick_box(rows, workspace, name):
    """The box `cb exec` means.

    By name: the full container name, or the random suffix after its last dash —
    the part that tells two runs of one checkout apart. By default: the one box
    of this workspace. Ambiguity is an error with the candidates listed, never a
    guess, because exec runs a command in whatever comes back.
    """
    if name:
        matches = [row[0] for row in rows if name in (row[0], row[0].rsplit("-", 1)[-1])]
        missing = "no running claude box called " + name
    else:
        matches = [row[0] for row in rows if row[2] == workspace]
        missing = "no running claude box for " + workspace
    if not matches:
        raise CbError(missing)
    if len(matches) > 1:
        raise CbError(
            "several running claude boxes match: {}\npick one with -n NAME".format(
                " ".join(sorted(matches))
            )
        )
    return matches[0]


# ---------------------------------------------------------------------------
# The image
# ---------------------------------------------------------------------------


def image_state_path():
    return os.path.join(state_dir(), "image.json")


def fetch_json(url):
    """Parsed JSON from `url`, or None if it could not be had.

    Every caller wants a version and has a pin to fall back on, so a refused
    lookup, a timeout, a rate limit and an error document are one answer: no.
    """
    try:
        with urllib.request.urlopen(url, timeout=5) as response:
            return json.load(response)
    except Exception:
        return None


def claude_version():
    """Newest published claude-code version, as a concrete value.

    "latest" would be useless as a build arg: Docker caches a RUN layer by its
    instruction text, not by what the tag resolved to, so `npm install …@latest`
    stays frozen forever. A concrete version changes the text exactly when a
    release happens.

    Any failure falls back to "latest", which simply leaves the layer cached.
    The scope separator has to be encoded — the registry reads an unescaped
    slash as a path.
    """
    url = "https://registry.npmjs.org/{}/latest".format(
        CLAUDE_PACKAGE.replace("/", "%2f")
    )
    payload = fetch_json(url)
    try:
        return payload["version"]
    except (TypeError, KeyError):
        return "latest"


# ---------------------------------------------------------------------------
# Toolchain versions
#
# uv, Go, OpenTofu and kubectl arrive as images, and the Dockerfile pins each
# with an ARG that a --build-arg overrides. cb resolves the newest release from
# upstream rather than leaving the tag floating, for the same reason claude-code
# gets a concrete version: a moving tag is re-resolved on a build cb did not
# mean to change anything with. `cb update-claude` exists to redo one npm install, and a
# Go release landing in the middle of it would invalidate the Go layer and
# everything below — so latest is asked for when an image is built from nothing
# or rebuilt on purpose, remembered, and reused after that.
#
# Each lookup is the plainest unauthenticated endpoint its project publishes, and
# each returns None rather than raising: the Dockerfile's own pin is the fallback
# and a build must not depend on four third parties being up.
# ---------------------------------------------------------------------------


def parse_uv_version(payload):
    """uv is published to PyPI in lockstep with its image tags."""
    try:
        return payload["info"]["version"] or None
    except (TypeError, KeyError):
        return None


def parse_go_version(payload):
    """The download index lists releases newest first, as "go1.26.5".

    Only stable ones: the index carries release candidates too, and the golang
    image publishes those under a tag of their own that -trixie does not follow.
    """
    try:
        for release in payload:
            if release.get("stable") and release.get("version", "").startswith("go"):
                return release["version"][len("go"):] or None
    except TypeError:
        return None
    return None


def parse_github_release(payload):
    """GitHub's latest release, which excludes drafts and pre-releases.

    Both image tags that follow a GitHub release are built from the bare
    version: tofu's is <version>-minimal, and the Dockerfile puts kubectl's "v"
    back itself.
    """
    try:
        return payload["tag_name"].lstrip("v") or None
    except (TypeError, KeyError, AttributeError):
        return None


# Name to the build arg that pins it and the lookup that answers for it. The
# name is also the key in the state file, so it stays short and lowercase.
TOOLCHAINS = {
    "go": ("GO_VERSION", "https://go.dev/dl/?mode=json", parse_go_version),
    "kubectl": (
        "KUBECTL_VERSION",
        "https://api.github.com/repos/kubernetes/kubernetes/releases/latest",
        parse_github_release,
    ),
    "tofu": (
        "TOFU_VERSION",
        "https://api.github.com/repos/opentofu/opentofu/releases/latest",
        parse_github_release,
    ),
    "uv": ("UV_VERSION", "https://pypi.org/pypi/uv/json", parse_uv_version),
}


# Set by the Dockerfile on images that carry cb-entry. ensure_image() rebuilds
# one that lacks it.
ENTRY_LABEL = "cb.entry"

# What the image records about itself. claude-code is in there too — it is the
# version question asked most often, and nothing else in the image can answer it.
VERSION_LABEL = "cb.versions"
LABELLED_VERSIONS = ("claude",) + tuple(TOOLCHAINS)


def parse_version_label(label):
    """Read back what the image's cb.versions label says.

    Unknown and empty entries are dropped rather than raising: the label is read
    from whatever image is tagged claude-box:latest, which may predate a
    toolchain and leave its ARG expanding to nothing.
    """
    versions = {}
    for entry in (label or "").split(","):
        name, _, value = entry.partition("=")
        if name in LABELLED_VERSIONS and value:
            versions[name] = value
    return versions


def latest_versions():
    """Newest upstream version per toolchain. What could not be resolved is
    absent rather than guessed at."""
    found = {}
    for name, (_, url, parse) in sorted(TOOLCHAINS.items()):
        version = parse(fetch_json(url))
        if version:
            found[name] = version
    return found


def version_build_args(versions):
    """`X_VERSION=…` assignments, for `docker build --build-arg`."""
    return [
        "{}={}".format(TOOLCHAINS[name][0], version)
        for name, version in sorted(versions.items())
        if name in TOOLCHAINS
    ]


def stored_versions(stored):
    """What the last build settled on, known toolchains only.

    Anything else in there is ignored for the same reason the feature keys are:
    a leftover or a hand edit must not decide what gets built.
    """
    versions = stored.get("versions")
    if not isinstance(versions, dict):
        return {}
    return {
        name: str(value)
        for name, value in versions.items()
        if name in TOOLCHAINS and value
    }


def refresh_versions(stored):
    """Remembered versions, updated with whatever upstream answers now.

    Updated rather than replaced: a lookup that fails would otherwise roll that
    toolchain back to the Dockerfile's pin, which is a downgrade nobody asked
    for and one that reads as a mystery rebuild.
    """
    versions = stored_versions(stored)
    versions.update(latest_versions())
    return versions


def remember_image_state(features, versions):
    """Both halves of what the next build should reproduce.

    Features stay at the top level, where resolve_features already reads them, so
    a file written by an older cb keeps working.
    """
    state = dict(features)
    state["versions"] = versions
    write_json(image_state_path(), state)


def image_exists():
    return capture(["docker", "image", "inspect", CB_IMAGE]) is not None


def image_label(name):
    """One label off the image, or None if there is no image to read it from."""
    out = capture(
        [
            "docker",
            "image",
            "inspect",
            "--format",
            '{{index .Config.Labels "%s"}}' % name,
            CB_IMAGE,
        ]
    )
    return None if out is None else out.strip()


def image_features():
    """What the image on disk was built with, or None if there is no image.

    Read from the image's own label rather than from image.json, so the answer
    stays right when the state file has been lost or hand-edited.
    """
    label = image_label(FEATURE_LABEL)
    return None if label is None else parse_feature_label(label)


def image_versions():
    """Which versions the image on disk was built at, the same way."""
    label = image_label(VERSION_LABEL)
    return {} if label is None else parse_version_label(label)


def build_env():
    """The environment `docker build` runs in.

    BuildKit is not optional for this Dockerfile: it opens with a `# syntax`
    directive and uses COPY --chmod, and the classic builder ignores the first
    and rejects the second — at a COPY near the end, so the refusal arrives
    after the Rust toolchain, the from-source sqlx-cli build and the Playwright
    layer have been redone for nothing.

    Docker already picks BuildKit wherever the buildx component is installed, so
    this only decides anything where the build could not have succeeded anyway:
    a DOCKER_BUILDKIT=0 exported for some other project, or a CLI without buildx.
    Both now say so before the first layer instead of twenty minutes in.
    """
    env = dict(os.environ)
    env["DOCKER_BUILDKIT"] = "1"
    return env


def build_image(features, versions, no_cache=False):
    argv = ["docker", "build"]
    if no_cache:
        argv.append("--no-cache")
    argv += ["--build-arg", "CLAUDE_CODE_VERSION=" + claude_version()]
    for assignment in feature_build_args(features) + version_build_args(versions):
        argv += ["--build-arg", assignment]
    argv += ["--tag", CB_IMAGE, CB_DIR]
    run(argv, env=build_env())


def ensure_image():
    """Build only what is missing.

    The image has to exist before a container can run, but keeping it current is
    update-claude's job, not something every `cb` pays for: `cb` runs many times
    a day and almost always on a warm cache, where a build is a registry round
    trip plus twenty lines of CACHED that read like a rebuild.

    Nothing is cached on a first build, so this is the one place besides
    rebuild-image where asking upstream for the newest toolchains costs nothing.

    An image without cb-entry counts as missing: every box runs it, and docker
    would fail on it only after cb has exec'd away and can no longer say why.
    That rebuild keeps the image's own versions, like update-claude, so only the
    layers from cb-entry down are redone.
    """
    if image_exists():
        if image_label(ENTRY_LABEL):
            return
        print("cb: {} predates cb-entry, rebuilding".format(CB_IMAGE), file=sys.stderr)
        stored = read_json(image_state_path())
        build_image(resolve_features(stored, {}), stored_versions(stored))
        return
    stored = read_json(image_state_path())
    features = resolve_features(stored, {})
    versions = refresh_versions(stored)
    remember_image_state(features, versions)
    build_image(features, versions)


# ---------------------------------------------------------------------------
# The container
#
# One `docker run --rm` per invocation: a box lives exactly as long as the
# claude or shell it was started for, and several can run for one checkout at
# once. Nothing persists in the container; what has to survive a run lives on
# the host (~/.claude, the checkout) or in a volume (shell history, browsers).
#
# This is also what devcontainer.json used to hold, said in docker's own flags.
# The CLI bought a create-or-start decision and a labelled container, and cost a
# node process per invocation plus a config format whose only way to reach a
# per-box value was ${localEnv:…} — every one of CB_NAME, CB_PROJECT and CB_DIND
# was smuggled through the environment because the CLI offers no variable that
# is both sanitized and unique.
#
# Two things the CLI did are deliberately not reproduced. Its customizations
# listed a VS Code extension and a terminal profile, which only an editor
# opening the folder ever read, and a box is driven from a terminal. And
# updateRemoteUserUID, on by default, rebuilt the image to remap node's uid onto
# the host user's — unnecessary on OrbStack, whose virtiofs presents a mount as
# whoever reads it, and a no-op anyway wherever the host user is uid 1000 like
# the image's node. On a Linux host with a different uid, files cb writes into
# the checkout would land owned by 1000; add --user "$(id -u):$(id -g)" here if
# that ever bites, and expect to fix up /home/node at the same time.
# ---------------------------------------------------------------------------

BOX_USER = "node"
WORKSPACES = "/workspaces"

# The host's ~/.claude is bind-mounted into every box, so the login
# (.credentials.json plus oauthAccount/userID in .claude.json), settings.json
# and plugins/ are set up once and then shared. On the host that state is
# greppable, backup-able and out of reach of `docker volume prune`.
#
# Ownership takes care of itself: OrbStack's virtiofs presents the mount as
# whoever reads it, so the files are node inside the box and the host user
# outside. No chown, no uid juggling.
#
# Nothing on the host may write this directory. plugins/cache/ holds native
# binaries built for linux-arm64 and daemon.lock carries container pids, so a
# Claude Code running on macOS itself would load both and break. If that ever
# starts, give the boxes their own directory rather than sharing this one.
HOST_CLAUDE_DIR = os.path.expanduser("~/.claude")
BOX_CLAUDE_DIR = "/home/{}/.claude".format(BOX_USER)

# The image's entrypoint for every box: starts dind when asked, then execs the
# command. See cb-entry.
CB_ENTRY = "/usr/local/bin/cb-entry"

# Host variables worth having inside the box: both are how a terminal announces
# itself, and Claude Code reads them to decide what it may draw.
PASSTHROUGH_ENV = ("TERM_PROGRAM", "LC_TERMINAL")

def workspace_folder(workspace):
    """Where the checkout is mounted inside the box.

    Unique per repo, because everything Claude keys by project is keyed by this
    path: projects/<escaped path>/ holds transcripts and memory, .claude.json
    has a "projects" section per path (allowedTools, mcpServers, trust), and
    history.jsonl tags each prompt with its project. With a fixed /workspace
    every box would be the same project and would share all of it.

    Deliberately carries no hash — it shows up in the prompt and in every path
    Claude prints, so it stays readable. Two repos whose directory name is
    identical therefore do share one project identity; rename one of them if
    that matters.
    """
    return "{}/{}".format(WORKSPACES, slug(os.path.basename(workspace)))


def history_volume(workspace):
    """Shell history stays per repo and stays a volume, being throwaway state
    that would only clutter the host. Drop the hash for one shared history.

    The devcontainer version of cb named these after ${devcontainerId}, a digest
    of its own. Those volumes are orphaned rather than migrated — this is
    throwaway state, and `docker volume ls | grep cb-history-` finds them for
    anyone who wants the disk back.
    """
    return "cb-history-" + path_hash(workspace)


def ensure_history_volume(workspace):
    """Create the history volume with the folder it belongs to as a label.

    Every history volume is dangling between runs now, so `cb volume prune`
    needs the label to tell a gone checkout from one that is just idle.
    `docker volume create` on an existing name is a no-op and leaves its labels
    as they were — a volume from before this label stays unlabelled.
    """
    run(
        [
            "docker", "volume", "create",
            "--label", "{}={}".format(FOLDER_LABEL, workspace),
            history_volume(workspace),
        ],
        quiet=True,
    )


# Browsers Playwright downloads, shared by every box and kept across runs. Home
# only lives as long as the container, so without this a project's
# `npx playwright install` starts from zero on every run.
# Shared rather than per repo because a revision is the same bytes whichever
# project asked for it: one download per revision per machine.
#
# The default location, so no PLAYWRIGHT_BROWSERS_PATH is needed and a project
# that sets its own is left alone. The image creates the directory as node;
# docker copies that ownership into the volume when it first mounts it, and
# would otherwise create it root-owned — along with ~/.cache itself, which
# CARGO_TARGET_DIR lives under.
PLAYWRIGHT_VOLUME = "cb-playwright"
PLAYWRIGHT_DIR = "/home/{}/.cache/ms-playwright".format(BOX_USER)


# ---------------------------------------------------------------------------
# Extra mounts
#
# Directories beyond the checkout, given per run with -v or remembered per
# workspace with `cb mount add`. A mount is a (source, target, readonly) tuple;
# the spec string is SRC[:DST][:ro|rw], close enough to docker's -v that the
# fingers already know it.
#
# Without DST a mount lands where the checkout itself would if cb had been
# started there: /workspaces/<slug>. A sibling repo mounted next to the current
# one then has the same path it has in its own box, and Claude's per-project
# state lines up between the two.
# ---------------------------------------------------------------------------

MOUNT_MODES = ("ro", "rw")


def resolve_path(path, base):
    """`path` relative to `base`, resolved the way the shell's cd would.

    Logical rather than realpath, for the reason current_workspace() prefers
    $PWD: the folder label is written in that spelling, and a symlink resolved
    here would be a different folder there.
    """
    return os.path.normpath(os.path.join(base, os.path.expanduser(path)))


def parse_mount(spec, workspace):
    """(source, target, readonly) from SRC[:DST][:ro|rw].

    DST has to be absolute, which is what keeps `src:ro` unambiguous: "ro" can
    never be a target. A comma anywhere is refused for the reason run_argv
    gives — docker reads --mount as CSV.
    """
    parts = spec.split(":")
    readonly = False
    if len(parts) > 1 and parts[-1] in MOUNT_MODES:
        readonly = parts.pop() == "ro"
    if len(parts) > 2 or not parts[0]:
        raise UsageError("cannot read mount {} (want SRC[:DST][:ro])".format(spec))

    source = resolve_path(parts[0], workspace)
    if len(parts) == 2:
        if not os.path.isabs(parts[1]):
            raise UsageError("mount target must be absolute: {}".format(spec))
        target = os.path.normpath(parts[1])
    else:
        target = workspace_folder(source)

    if "," in source or "," in target:
        raise UsageError(
            "cannot mount {}: docker reads a comma in a --mount path as the end "
            "of the field".format(spec)
        )
    return (source, target, readonly)


def format_mount(mount):
    """The spec string parse_mount reads back, as stored in the settings."""
    source, target, readonly = mount
    return "{}:{}{}".format(source, target, ":ro" if readonly else "")


def mount_value(mount):
    source, target, readonly = mount
    value = "type=bind,source={},target={}".format(source, target)
    return value + ",readonly" if readonly else value


def merge_mounts(persistent, per_run):
    """Remembered mounts, then this run's. A run's mount on a remembered target
    replaces it — the way to make one read-only, or point it elsewhere, for a
    single run. Two of this run's own on one target is a typo."""
    merged = {mount[1]: mount for mount in persistent}
    seen = set()
    for mount in per_run:
        if mount[1] in seen:
            raise UsageError("two mounts for {}".format(mount[1]))
        seen.add(mount[1])
        merged[mount[1]] = mount
    return list(merged.values())


def fixed_targets(workspace):
    """Where cb itself mounts something. An extra mount on or around one of
    these would hide it."""
    return [workspace_folder(workspace), BOX_CLAUDE_DIR, "/commandhistory", PLAYWRIGHT_DIR]


def nested(a, b):
    """Is `a` equal to `b`, or one inside the other?"""
    a, b = a.rstrip("/") + "/", b.rstrip("/") + "/"
    return a.startswith(b) or b.startswith(a)


def check_targets(mounts, fixed):
    for source, target, _ in mounts:
        for taken in fixed:
            if nested(target, taken):
                raise UsageError(
                    "cannot mount {} at {}: cb already mounts {} there".format(
                        source, target, taken
                    )
                )


def require_sources(mounts):
    """docker refuses a missing bind source too, but with a line about the
    daemon rather than about the typo."""
    for source, _, _ in mounts:
        if not os.path.exists(source):
            raise CbError("mount source does not exist: " + source)


def container_env(docker):
    """The environment a box starts with.

    CB_DIND is what cb-entry hands to cb-dockerd, through sudo, to decide
    whether this box gets a daemon.
    """
    env = {
        "CB_DIND": "true" if docker else "false",
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
        "CLAUDE_CONFIG_DIR": BOX_CLAUDE_DIR,
        "NODE_OPTIONS": "--max-old-space-size=4096",
        # Ctrl+G wrapper for the /reply skill in the shared ~/.claude; it falls
        # back to plain vim outside Claude Code. claude is exec'd without a
        # shell, so this cannot live in a zsh startup file.
        "VISUAL": BOX_CLAUDE_DIR + "/skills/reply/editor.sh",
        # `playwright install` deletes every revision no installed Playwright
        # still links to, and it checks the links by path. In the shared volume
        # the other boxes' node_modules are not visible, so without this each box
        # would delete the browsers of every other one.
        "PLAYWRIGHT_SKIP_BROWSER_GC": "1",
    }
    for name in PASSTHROUGH_ENV:
        value = os.environ.get(name)
        if value:
            env[name] = value
    return env


def run_argv(workspace, docker, mounts, command, tty=None, suffix=None):
    """The whole of a box, as one `docker run`.

    --rm and the command in the foreground: the box lives exactly as long as
    claude (or the shell) does, and nothing is left behind when the terminal
    goes away. Several runs per checkout can exist at once, so the name carries
    a random suffix; the hostname does not, so the prompt stays the same.

    --mount rather than -v: it names its parts, and it refuses to invent a
    missing bind source instead of creating it root-owned.

    --privileged is what lets dockerd inside the box mount, write cgroups and
    program iptables, so only a box that asked for docker gets those rights.

    The tty is asked for rather than assumed, and TERM forwarded with it — see
    exec_argv.
    """
    # docker parses a --mount value as CSV, so a comma in the path would split
    # the field and the flag would be rejected with something unrelated to the
    # cause.
    if "," in workspace:
        raise UsageError(
            "cannot mount {}: docker reads a comma in a --mount path as the end "
            "of the field\nrename the directory".format(workspace)
        )
    if tty is None:
        tty = sys.stdin.isatty() and sys.stdout.isatty()

    base = container_name(workspace)
    folder = workspace_folder(workspace)

    argv = ["docker", "run", "--rm", "--init", "--interactive"]
    if tty:
        argv.append("--tty")
        if os.environ.get("TERM"):
            argv += ["--env", "TERM=" + os.environ["TERM"]]
    argv += [
        "--name",
        "{}-{}".format(base, suffix or secrets.token_hex(2)),
        # Without this the prompt inside the box shows a random hex id.
        "--hostname",
        base,
        "--label",
        "{}={}".format(BOX_LABEL, BOX_GENERATION),
        "--label",
        "{}={}".format(FOLDER_LABEL, workspace),
        "--workdir",
        folder,
    ]
    if docker:
        argv.append("--privileged")

    for source, target in (
        (workspace, folder),
        (HOST_CLAUDE_DIR, BOX_CLAUDE_DIR),
    ):
        argv += ["--mount", "type=bind,source={},target={}".format(source, target)]
    for source, target in (
        (history_volume(workspace), "/commandhistory"),
        (PLAYWRIGHT_VOLUME, PLAYWRIGHT_DIR),
    ):
        argv += ["--mount", "type=volume,source={},target={}".format(source, target)]
    for mount in mounts:
        argv += ["--mount", mount_value(mount)]

    for key, value in container_env(docker).items():
        argv += ["--env", "{}={}".format(key, value)]

    return argv + [CB_IMAGE, CB_ENTRY] + list(command)


def exec_argv(name, command, tty=None):
    """Run `command` inside the running box called `name`.

    The tty is asked for rather than assumed: `docker exec --tty` fails outright
    with "the input device is not a TTY" wherever there is none, which is the
    normal case for a hook or a script.

    TERM is forwarded with the tty, because docker otherwise hands the command a
    bare TERM=xterm, which costs tmux and vim inside the box their colours.
    """
    if tty is None:
        tty = sys.stdin.isatty() and sys.stdout.isatty()

    argv = ["docker", "exec", "--interactive"]
    if tty:
        argv.append("--tty")
        if os.environ.get("TERM"):
            argv += ["--env", "TERM=" + os.environ["TERM"]]

    # Everything after the container name is the command: docker stops reading
    # flags there, so `cb exec docker ps --all` needs no `--`.
    return argv + [name] + list(command)


def ensure_claude_dir():
    """Docker refuses to bind a source that does not exist, and a first run on a
    fresh machine has no ~/.claude yet."""
    if DRY_RUN:
        print("+ mkdir -p " + HOST_CLAUDE_DIR)
        return
    os.makedirs(HOST_CLAUDE_DIR, exist_ok=True)


def replace_process(argv):
    """Hand the terminal to `argv`, and do not come back.

    execvp rather than a subprocess: the exit code, the signals and the TTY all
    belong to claude, and cb has nothing left to do once it has started.
    """
    if DRY_RUN:
        print("+ " + shlex.join(argv))
        return
    try:
        os.execvp(argv[0], argv)
    except FileNotFoundError:
        raise MissingBinary(argv[0])


def hand_over(name, command):
    """Run `command` inside the running box called `name`."""
    replace_process(exec_argv(name, command))


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------


def box_settings(workspace, flags):
    """This box's effective settings, and the overrides that shaped them.

    Resolving and remembering are two steps so that nothing is written before
    the gate has had its say — a directory cb refuses to start in must not be
    left with a settings file behind it.
    """
    overrides = {"docker": flags["docker"], "force": flags["force"]}
    stored = load_settings(settings_path(workspace))
    return resolve_settings(stored, overrides), overrides


def remember(workspace, overrides):
    """Persist whatever the flags decided, so the next run needs no flags."""
    if any(value is not None for value in overrides.values()):
        save_settings(settings_path(workspace), overrides, workspace)


def stored_mounts(stored):
    """Remembered mounts as tuples.

    A broken entry is an error, not skipped: unlike a bad bool, a silently
    dropped mount means the agent works without data it was promised.
    """
    specs = stored.get("mounts") or []
    if not isinstance(specs, list):
        raise CbError("settings: mounts must be a list")
    return [parse_mount(str(spec), "/") for spec in specs]


def box_mounts(workspace, specs):
    """Remembered mounts plus this run's, checked before anything starts."""
    persistent = stored_mounts(load_settings(settings_path(workspace)))
    per_run = [parse_mount(spec, workspace) for spec in specs]
    mounts = merge_mounts(persistent, per_run)
    check_targets(mounts, fixed_targets(workspace))
    require_sources(mounts)
    return mounts


def check_gate(workspace, force):
    """Refuse to start a box outside the roots."""
    if force or in_roots(workspace, roots()):
        return
    raise UsageError(
        "refusing to start a claude box in {}\n"
        "boxes belong under {} — pass --force to override".format(
            workspace, " or ".join(roots())
        )
    )


def check_docker_feature(docker):
    """Container privilege and the docker binaries are two different things.

    A privileged box built from an image without docker.io gets a daemon that
    cannot start, and the only trace is a line in cb-dockerd's log inside the
    container. Catch it here instead.
    """
    if not docker:
        return
    features = image_features()
    if features is not None and features.get("docker") is False:
        raise UsageError(
            "this box wants docker but {} was built without it\n"
            "run: cb rebuild-image --with-docker".format(CB_IMAGE)
        )


def start(flags, command):
    """A fresh box for the current directory, running `command`.

    The gate applies every time, since every run creates a container; --force
    is remembered per workspace, so that costs one flag once.
    """
    workspace = current_workspace()
    settings, overrides = box_settings(workspace, flags)
    docker = settings["docker"][0]

    check_gate(workspace, settings["force"][0])
    mounts = box_mounts(workspace, flags["volumes"])
    remember(workspace, overrides)
    ensure_image()
    check_docker_feature(docker)
    ensure_claude_dir()
    ensure_history_volume(workspace)
    replace_process(run_argv(workspace, docker, mounts, command))
    return 0


def cmd_run(flags, claude_args):
    return start(flags, ["claude"] + claude_args)


def cmd_shell(flags, args):
    reject_extra("shell", args)
    return start(flags, ["zsh"])


def cmd_update_claude(flags, args):
    """Pull in a new claude-code release for the next run.

    Cheap on purpose: claude-code is the last layer in the Dockerfile, so a bump
    invalidates nothing above it. With the version unchanged every layer is a
    cache hit and this is a registry lookup and nothing else.

    Builds and stops: every run starts from the image, so the next one has the
    new binary. Boxes already running keep theirs until they exit.

    The toolchains are the ones the image already has, deliberately: resolving
    them here would bump Go or uv as a side effect of a claude-code release and
    invalidate every layer below, which is exactly what this command avoids.
    """
    reject_extra("update-claude", args)
    stored = read_json(image_state_path())
    build_image(resolve_features(stored, {}), stored_versions(stored))

    if not DRY_RUN:
        print("\nbuilt {}. the next run uses it.".format(CB_IMAGE))
    return 0


def cmd_rebuild_image(flags, args):
    """Rebuild the shared image, optionally changing which toolchains it has.

    This is also where the toolchain versions are refreshed: asking upstream for
    the newest uv, Go, OpenTofu and kubectl belongs to "rebuild the image", not to a
    command that is supposed to touch one layer.

    Feature flags are remembered, so a later bare `cb rebuild-image` reproduces
    the same set. --no-cache is the nuclear option: it discards the Rust
    toolchain, the from-source sqlx-cli build and the Playwright apt layer,
    which update-claude gets you without.

    Builds and stops. Every run starts from the image, so the next one picks it
    up; a box already running keeps the image it was started from until it
    exits, hence the closing line.
    """
    overrides, args = extract_feature_flags(args)
    no_cache = "--no-cache" in args
    reject_extra("rebuild-image", [arg for arg in args if arg != "--no-cache"])

    stored = read_json(image_state_path())
    features = resolve_features(stored, overrides)
    versions = refresh_versions(stored)
    remember_image_state(features, versions)
    build_image(features, versions, no_cache=no_cache)

    if not DRY_RUN:
        print("\nbuilt {}. running boxes keep the old image until "
              "they exit.".format(CB_IMAGE))
    return 0


def ls_folder(args, workspace):
    """The folder `cb ls DIR` asks about, or None for every box."""
    if len(args) > 1:
        raise UsageError("cb ls: unexpected argument: {}".format(args[1]))
    return resolve_path(args[0], workspace) if args else None


def cmd_ls(flags, args):
    folder = ls_folder(args, current_workspace())
    rows = running_boxes()
    if folder is not None:
        rows = [row for row in rows if row[2] == folder]
    print(format_table(rows))
    return 0


def split_exec_args(args):
    """(name, command) from `[-n NAME] CMD…`. Only a leading -n is cb's; the
    rest is the command's own line."""
    name = None
    if args[:1] == ["-n"]:
        if len(args) < 2:
            raise UsageError("cb exec -n needs a box name")
        name, args = args[1], args[2:]
    if not args:
        raise UsageError("cb exec needs a command")
    return name, list(args)


def cmd_exec(args):
    name, command = split_exec_args(args)
    hand_over(pick_box(running_boxes(), current_workspace(), name), command)
    return 0


def cmd_config(flags, args):
    if args == ["--prune"]:
        return prune_settings()
    if len(args) == 2:
        return set_setting(args[0], args[1])
    if len(args) == 1:
        return show_setting(args[0])
    reject_extra("config", args)

    workspace = current_workspace()
    settings = resolve_settings(load_settings(settings_path(workspace)), {})
    for key in sorted(settings):
        value, source = settings[key]
        print("{:<8} {:<6} ({})".format(key, str(value).lower(), source))

    mounts = stored_mounts(load_settings(settings_path(workspace)))
    print("{:<8} {:<6} (cb mount ls)".format("mounts", len(mounts)))

    features = image_features()
    if features is None:
        print("\nimage    {} is not built".format(CB_IMAGE))
    else:
        enabled = sorted(name for name, on in features.items() if on) or ["none"]
        print("\nimage    {}  {}".format(CB_IMAGE, " ".join(enabled)))
        versions = image_versions()
        if versions:
            print(
                "         "
                + "  ".join(
                    "{} {}".format(name, versions[name]) for name in sorted(versions)
                )
            )
    return 0


def show_setting(key):
    workspace = current_workspace()
    settings = resolve_settings(load_settings(settings_path(workspace)), {})
    if key not in settings:
        raise UsageError(
            "unknown setting: {} (known: {})".format(
                key, " ".join(sorted(SETTINGS_DEFAULTS))
            )
        )
    value, source = settings[key]
    print("{} {} ({})".format(key, str(value).lower(), source))
    return 0


def set_setting(key, value):
    if key == "mounts":
        raise UsageError("mounts are set with `cb mount add|rm`")
    if key not in SETTINGS_DEFAULTS:
        raise UsageError(
            "unknown setting: {} (known: {})".format(
                key, " ".join(sorted(SETTINGS_DEFAULTS))
            )
        )
    if value not in ("true", "false"):
        raise UsageError("{} takes true or false, not {}".format(key, value))
    workspace = current_workspace()
    save_settings(settings_path(workspace), {key: value == "true"}, workspace)
    print("{} {} ({})".format(key, value, settings_path(workspace)))
    return 0


def prune_settings():
    """Drop entries whose directory is gone.

    The store is keyed by path, so a deleted checkout leaves a file behind that
    nothing will ever read again.
    """
    directory = os.path.join(state_dir(), "projects")
    removed = []
    for name in sorted(os.listdir(directory)) if os.path.isdir(directory) else []:
        path = os.path.join(directory, name)
        workspace = read_json(path).get("path")
        if workspace and not os.path.isdir(workspace):
            if DRY_RUN:
                print("+ rm " + path)
            else:
                os.remove(path)
            removed.append(workspace)
    print("pruned: " + ", ".join(removed) if removed else "nothing to prune")
    return 0


MOUNT_USAGE = "usage: cb mount add SRC[:DST][:ro] | cb mount rm SRC|DST | cb mount ls"


def cmd_mount(flags, args):
    """Mounts remembered for this workspace, applied to every run started here.

    Stored as normalised spec strings next to docker and force, so the settings
    file stays readable and hand-editable.
    """
    workspace = current_workspace()
    path = settings_path(workspace)
    current = stored_mounts(load_settings(path))

    if args == ["ls"]:
        for source, target, readonly in current:
            print("{}  {}  {}".format(source, target, "ro" if readonly else "rw"))
        return 0

    if len(args) == 2 and args[0] == "add":
        mount = parse_mount(args[1], workspace)
        if any(existing[1] == mount[1] for existing in current):
            raise UsageError("something is already mounted at " + mount[1])
        check_targets([mount], fixed_targets(workspace))
        require_sources([mount])
        updated = current + [mount]
    elif len(args) == 2 and args[0] == "rm":
        key = resolve_path(args[1], workspace)
        updated = [mount for mount in current if key not in (mount[0], mount[1])]
        if len(updated) == len(current):
            raise CbError("no mount for " + args[1])
    else:
        raise UsageError(MOUNT_USAGE)

    save_settings(path, {"mounts": [format_mount(m) for m in updated]}, workspace)
    print("{} mount(s) ({})".format(len(updated), path))
    return 0


VOLUME_TARGETS = ("all", "playwright")


def cmd_volume(flags, args):
    """`cb volume prune <all|playwright>`: give back the disk cb's volumes hold.

    playwright empties the shared browser cache, which only grows since GC is
    off (see container_env). It is emptied rather than removed because every box
    has it mounted, and docker refuses to remove a volume any container uses,
    even a stopped one. The next `playwright install` fetches what is needed.

    all adds the shell history of checkouts that no longer exist. The history of
    one that still exists is kept, whether or not a box is running for it.
    """
    if len(args) != 2 or args[0] != "prune" or args[1] not in VOLUME_TARGETS:
        raise UsageError("usage: cb volume prune <{}>".format("|".join(VOLUME_TARGETS)))

    histories, unlabelled = [], []
    if args[1] == "all":
        histories, unlabelled = orphaned_history_volumes()
    has_browsers = capture(["docker", "volume", "inspect", PLAYWRIGHT_VOLUME]) is not None

    if unlabelled:
        print("skipped (no label): " + " ".join(unlabelled))
    if not histories and not has_browsers:
        print("nothing to prune")
        return 0
    if has_browsers:
        print("empty:  " + PLAYWRIGHT_VOLUME)
    if histories:
        print("remove: " + " ".join(histories))
    if not confirm("prune?", flags["yes"] or DRY_RUN):
        raise CbError("aborted")

    if has_browsers:
        run(empty_volume_argv(PLAYWRIGHT_VOLUME), quiet=True)
    if histories:
        run(["docker", "volume", "rm"] + histories, quiet=True)
    return 0


def empty_volume_argv(volume):
    """Delete everything inside `volume` but the volume itself.

    A throwaway container from cb's own image, because that is the one image
    certain to be there. --entrypoint rather than a command after the image, so
    nothing the image might ever run first gets in the way.
    """
    return [
        "docker",
        "run",
        "--rm",
        "--mount",
        "type=volume,source={},target=/volume".format(volume),
        "--entrypoint",
        "find",
        CB_IMAGE,
        "/volume",
        "-mindepth",
        "1",
        "-delete",
    ]


def orphaned_history_volumes():
    """(orphaned, unlabelled) cb-history-* volumes.

    Dangling alone means nothing any more: with --rm every history volume is
    dangling whenever no box of its checkout is running. Orphaned is dangling
    *and* labelled with a folder that no longer exists. Volumes from before the
    label are reported and left alone — docker cannot add a label afterwards,
    and guessing would delete live history.

    The name filter matches anywhere in the name, hence the prefix check.
    """
    out = capture(
        [
            "docker", "volume", "ls",
            "--filter", "dangling=true",
            "--filter", "name=cb-history-",
            "--format", '{{.Name}}\t{{.Label "%s"}}' % FOLDER_LABEL,
        ]
    )
    orphaned, unlabelled = [], []
    for line in (out or "").splitlines():
        name, _, folder = line.partition("\t")
        if not name.startswith("cb-history-"):
            continue
        if not folder:
            unlabelled.append(name)
        elif not os.path.isdir(folder):
            orphaned.append(name)
    return sorted(orphaned), sorted(unlabelled)


# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

USAGE = """usage: cb [command] [options]

  cb [run] [claude args…]  start a fresh box and run claude in it (default)
  cb shell                 a fresh box with zsh instead of claude
  cb exec [-n NAME] CMD…   run CMD in a running box of this directory, or the
                           one called NAME (full name or its last 4 characters)
  cb ls [DIR]              running boxes, all or those of DIR
  cb mount add SRC[:DST][:ro]
  cb mount rm SRC|DST
  cb mount ls              mounts every run in this directory gets
  cb update-claude         rebuild with the newest claude-code
  cb rebuild-image [--no-cache] [--with-X|--without-X]…
  cb config [KEY [VALUE]] [--prune]
  cb volume prune playwright
                           empty the browser cache every box shares
  cb volume prune all      that, plus the shell history of checkouts that are gone

options
  -v, --volume SRC[:DST][:ro]
                           mount SRC for this run; DST defaults to
                           /workspaces/<name of SRC>
  --docker, --no-docker    give the box its own docker daemon; remembered
  --force                  allow a box outside {roots}; remembered
  -y                       do not ask
  --dry-run                print the commands instead of running them
  --                       stop reading options; the rest is claude's

image features: {features}
""".format(roots=" and ".join(DEFAULT_ROOTS), features=" ".join(IMAGE_FEATURES))


def reject_extra(command, args):
    """An unknown argument is refused rather than ignored.

    A typo must not quietly hand back something other than what was asked for —
    the reason the old --dind parsing rejected them too.
    """
    if args:
        raise UsageError("cb {}: unexpected argument: {}".format(command, args[0]))


COMMANDS = {
    "run": cmd_run,
    "ls": cmd_ls,
    "shell": cmd_shell,
    "mount": cmd_mount,
    "rebuild-image": cmd_rebuild_image,
    "update-claude": cmd_update_claude,
    "config": cmd_config,
    "volume": cmd_volume,
}


def main(argv):
    global DRY_RUN

    name, rest = pick_subcommand(argv)

    # exec takes a command line of its own: `cb exec docker ps --force` passes
    # --force to docker, so only the flags in front of exec are cb's.
    if name in VERBATIM_SUBCOMMANDS:
        leading = leading_flags_end(argv)
        flags, _ = extract_flags(argv[:leading])
        if flags["help"]:
            print(USAGE, end="")
            return 0
        DRY_RUN = flags["dry_run"]
        return cmd_exec(rest[leading:])

    flags, args = extract_flags(rest)
    if flags["help"]:
        print(USAGE, end="")
        return 0
    DRY_RUN = flags["dry_run"]

    return COMMANDS[name](flags, args)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except CbError as error:
        print("cb: " + str(error), file=sys.stderr)
        sys.exit(error.code)
    except KeyboardInterrupt:
        sys.exit(130)
