{
  "name": "Claude Code",

  // Prebuilt image instead of a "build" block, so every repo shares one image.
  // With "build" the devcontainer CLI names the result vsc-<folder>-<hash of
  // the workspace path>, i.e. one image per repo, and `up` has no way to
  // override that name. The Dockerfile next to this file produces this tag;
  // cb builds it before calling `up`. Keep the tag in sync with CB_IMAGE in
  // ~/.local/bin/cb.
  "image": "claude-box:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": { "path": "zsh" }
        }
      }
    }
  },
  "remoteUser": "node",

  // Without this Docker hands out a random name (busy_grothendieck), which says
  // nothing in `docker ps` once several boxes run. The top-level "name" above
  // is only a display label for editors, so the actual name has to come from a
  // docker run flag.
  //
  // container_name() in cb builds cb-<project>-<path hash>; the hash keeps two
  // checkouts of the same directory name apart. The fallback only applies to a
  // hand-written `devcontainer up` outside cb.
  //
  // --privileged is what lets dockerd inside the box mount, write cgroups and
  // program iptables. Spelled with an explicit value rather than as a bare
  // flag so that only a box created with --dind gets those rights and every
  // other one stays unprivileged.
  //
  // runArgs are only read when the container is created, so switching this
  // replaces the container instead of restarting it.
  "runArgs": [
    "--name", "${localEnv:CB_NAME:claude-box}",
    "--hostname", "${localEnv:CB_NAME:claude-box}",
    "--privileged=${localEnv:CB_DIND:false}"
  ],
  // Docker creates a missing bind source itself, and on a Linux host that
  // directory lands root-owned, which node then cannot write. Creating it here
  // means a fresh machine works on either host.
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.claude",

  // The host's ~/.claude is bind-mounted into every box, so the login
  // (.credentials.json plus oauthAccount/userID in .claude.json),
  // settings.json and plugins/ are set up once and then shared. This used to
  // be a cb-config volume; on the host the same state is greppable,
  // backup-able and out of reach of `docker volume prune`.
  //
  // Ownership takes care of itself: OrbStack's virtiofs presents the mount as
  // whoever reads it, so the files are node inside the box and the host user
  // outside. No chown, no uid juggling.
  //
  // Nothing on the host may write this directory. plugins/cache/ holds native
  // binaries built for linux-arm64 and daemon.lock carries container pids, so
  // a Claude Code running on macOS itself would load both and break. If that
  // ever starts, give the boxes their own directory rather than sharing this
  // one.
  //
  // virtiofs is slower than a volume for the small constant writes in
  // projects/ and file-history/. Should that ever show, layer a volume back
  // over just those paths: Docker applies mounts by path depth, so a nested
  // mount on top of the bind wins.
  //
  // Everything project-scoped in there is keyed by the workspace path, not by
  // the container: projects/<escaped path>/ holds transcripts and memory,
  // .claude.json has a "projects" section per path (allowedTools, mcpServers,
  // trust), and history.jsonl tags each prompt with its project. That is why
  // workspaceFolder below must be unique per repo — with a fixed /workspace
  // every box would be the same project and would share its permissions,
  // memory and prompt history.
  //
  // Shell history stays per repo and stays a volume, being throwaway state
  // that would only clutter the host; make it "cb-history" without the id for
  // one shared history across boxes.
  "mounts": [
    "source=cb-history-${devcontainerId},target=/commandhistory,type=volume",
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind,consistency=delegated"
  ],
  "containerEnv": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "TERM_PROGRAM": "${localEnv:TERM_PROGRAM}",
    "LC_TERMINAL": "${localEnv:LC_TERMINAL}",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude",
    // Read by cb-dockerd to decide whether to start a daemon. Captured at
    // creation time on purpose: the container keeps the answer, so a later
    // plain `cb` brings the box back up with its daemon and does not have to
    // repeat the flag.
    "CB_DIND": "${localEnv:CB_DIND:false}"
  },
  // Runs on every start of the container, as node. A no-op unless CB_DIND is
  // true, so the boxes without Docker pay a process spawn and nothing else.
  "postStartCommand": "sudo /usr/local/bin/cb-dockerd",
  // Unique per repo (see the mounts comment). The path deliberately carries no
  // hash — it shows up in the prompt and in every path Claude prints, so it
  // stays readable. Two repos whose directory name is identical therefore do
  // share one project identity; rename one of the directories if that matters.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localEnv:CB_PROJECT:workspace},type=bind,consistency=delegated",
  "workspaceFolder": "/workspaces/${localEnv:CB_PROJECT:workspace}"
}
