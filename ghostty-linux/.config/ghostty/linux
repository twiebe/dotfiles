# Linux-only overrides, pulled in by `config-file = ?"linux"` in the shared
# config. Ghostty loads included files after the file that includes them, so
# settings here win. Stow this package on Linux only:
#   stow ghostty-linux

# Same point size renders larger on Linux than on macOS.
font-size = 11

# keyd maps Super+V to Ctrl+V under GNOME, so the shared super+v binding never
# fires here. Copy needs no binding: copy-on-select already fills the clipboard.
keybind = ctrl+v=paste_from_clipboard
